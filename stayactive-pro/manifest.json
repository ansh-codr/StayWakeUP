{
  "manifest_version": 3,
  "name": "StayActive Pro",
  "version": "1.0.0",
  "description": "Makes websites believe your tab is always active and visible, preventing paused video, music, or timers.",
  "minimum_chrome_version": "120",

  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "commands",
    "idle"
  ],

  "optional_host_permissions": ["<all_urls>"],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16_off.png",
      "32":  "icons/icon32_off.png",
      "48":  "icons/icon48_off.png",
      "128": "icons/icon128_off.png"
    },
    "default_title": "StayActive Pro"
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options/options.html",

  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Toggle StayActive Pro for the current site"
    }
  },

  "icons": {
    "16":  "icons/icon16_off.png",
    "32":  "icons/icon32_off.png",
    "48":  "icons/icon48_off.png",
    "128": "icons/icon128_off.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
